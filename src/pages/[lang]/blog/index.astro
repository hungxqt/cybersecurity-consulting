---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SheetHeader from '../../../components/SheetHeader.astro';
import HuntSpot from '../../../components/HuntSpot.astro';
import { formatDate, readingMinutes, resolveForLang, slugOf } from '../../../lib/content';
import { langStaticPaths } from '../../../lib/paths';
import { localizedPath, useT, type Lang } from '../../../lib/i18n';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const posts = resolveForLang(await getCollection('posts'), lang);
---

<BaseLayout lang={lang} theme="atlas" title={t('nav.blog')} description={t('blog.lede')}>
  <SheetHeader
    lang={lang}
    label={t('nav.blog')}
    titleDim={t('blog.title.dim')}
    titleStrong={t('blog.title.strong')}
    lede={t('blog.lede')}
  />
  <section class="section" aria-labelledby="articles-h">
    <div class="container">
      <h2 id="articles-h" class="section__label">
        {t('blog.articles')}
      </h2>
      {posts.length === 0 ? (
        <p>{t('blog.empty')}</p>
      ) : (
        <ul class="rows">
          {posts.map((p) => (
            <li class="row">
              <p class="row__rail label">
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang)}</time>
                <span>{p.data.tags[0]}</span>
              </p>
              <div class="row__body">
                <h3>
                  <a href={localizedPath(lang, `/blog/${slugOf(p.id)}/`)}>{p.data.title}</a>
                </h3>
                <p>{p.data.description}</p>
              </div>
              <p class="row__time label">
                {t('blog.minRead', { n: readingMinutes(p.body ?? '') })}
              </p>
            </li>
          ))}
        </ul>
      )}
      <p class="spot">
        <HuntSpot lang={lang} id="stale-dependency" />
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-2);
    padding-block: var(--s-5);
    border-top: 1px solid var(--rule);
  }
  .row p {
    margin: 0;
    max-width: none;
  }
  .row__rail {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
  }
  .row h3 {
    margin: 0 0 var(--s-2);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--fs-lead);
  }
  .row h3 a {
    color: var(--text);
    text-decoration: none;
  }
  /* The title link covers the whole row. */
  .row h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .row h3 a:hover {
    text-decoration: underline 1px var(--accent);
    text-underline-offset: 0.2em;
  }
  .row h3 a:focus-visible {
    outline: none;
  }
  .row:has(a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .row__body p {
    color: var(--text-dim);
    max-width: 64ch;
  }
  .spot {
    margin-top: var(--s-6);
  }
  @media (min-width: 1080px) {
    .row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .row__rail {
      grid-column: 1 / span 3;
      flex-direction: column;
    }
    .row__body {
      grid-column: 4 / span 7;
    }
    .row__time {
      grid-column: 11 / span 2;
      text-align: right;
    }
  }
</style>
