---
import { getCollection } from 'astro:content';
import BlogListing from '../../../components/BlogListing.astro';
import { BLOG_PAGE_SIZE } from '../../../lib/blog';
import { resolveForLang } from '../../../lib/content';
import { langStaticPaths } from '../../../lib/paths';
import type { Lang } from '../../../lib/i18n';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
const allPosts = resolveForLang(await getCollection('posts'), lang);
const posts = allPosts.slice(0, BLOG_PAGE_SIZE);
---

<BlogListing lang={lang} posts={posts} currentPage={1} total={allPosts.length} />
