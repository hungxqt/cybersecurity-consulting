---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SheetHeader from '../../../components/SheetHeader.astro';
import Icon from '../../../components/Icon.astro';
import { langStaticPaths } from '../../../lib/paths';
import { localizedHref, useT, type Lang } from '../../../lib/i18n';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
---

<BaseLayout lang={lang} theme="atlas" title={t('nav.careers')} description={t('careers.lede')}>
  <SheetHeader
    lang={lang}
    label={t('nav.careers')}
    titleDim={t('careers.title.dim')}
    titleStrong={t('careers.title.strong')}
    lede={t('careers.lede')}
  />
  <section class="section" aria-labelledby="open-h">
    <div class="container">
      <h2 id="open-h" class="section__label">
        {t('careers.open')}
      </h2>
      <p class="none">{t('careers.none')}</p>
      <a class="btn btn--primary" href={localizedHref(lang, '/contact/?topic=careers')}>
        {t('careers.cta')}
        <Icon name="arrow-right" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .none {
    max-width: var(--measure);
    margin-block: 0 var(--s-5);
  }
</style>
