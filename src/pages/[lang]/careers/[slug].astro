---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { forLang, slugOf } from '../../../lib/content';
import { LOCALES, localizedPath, useT, type Lang } from '../../../lib/i18n';
import { jobPosting } from '../../../lib/jsonld';
import { jobsAreSamples } from '../../../lib/site';

export async function getStaticPaths() {
  const all = await getCollection('jobs');
  return LOCALES.flatMap((lang) =>
    forLang(all, lang).map((entry) => ({
      params: { lang, slug: slugOf(entry.id) },
      props: { entry },
    })),
  );
}

const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const t = useT(lang);
const { Content } = await render(entry);
const slug = slugOf(entry.id);
const site = Astro.site ?? new URL('https://hungtran.example');
const ld = jobPosting({
  title: entry.data.title,
  description: entry.data.description,
  datePosted: entry.data.date,
  type: entry.data.type,
  location: entry.data.location,
  organization: t('site.name'),
  url: new URL(localizedPath(lang, `/careers/${slug}/`), site).href,
  lang,
});
const applyHref = `${localizedPath(lang, '/contact/')}?role=${encodeURIComponent(slug)}`;
---

<BaseLayout
  lang={lang}
  theme="atlas"
  title={entry.data.title}
  description={entry.data.description}
  path={`/careers/${slug}/`}
  jsonLd={ld}
>
  <article class="container job">
    <a class="back" href={localizedPath(lang, '/careers/')}>
      <Icon name="arrow-left" />
      {t('careers.back')}
    </a>
    {jobsAreSamples && (
      <p class="sample-note" role="note" data-sample>
        {t('careers.sample')}
      </p>
    )}
    <div class="job__grid">
      <dl class="rail mono">
        <div>
          <dt>{t('careers.team')}</dt>
          <dd>{t(`nav.${entry.data.team}`)}</dd>
        </div>
        <div>
          <dt>{t('careers.location')}</dt>
          <dd>{entry.data.location}</dd>
        </div>
        <div>
          <dt>{t('careers.type')}</dt>
          <dd>{t(`careers.type.${entry.data.type}`)}</dd>
        </div>
        <div>
          <dt>{t('careers.level')}</dt>
          <dd>{t(`careers.level.${entry.data.level}`)}</dd>
        </div>
      </dl>
      <div class="job__main">
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
        <div class="prose">
          <Content />
        </div>
        <p class="apply">
          <a class="btn btn--primary" href={applyHref}>
            {t('careers.apply')}
            <Icon name="arrow-right" />
          </a>
        </p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .sample-note {
    max-width: var(--measure);
    margin: 0 0 var(--s-5);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--rule-ui);
    background: var(--surface);
    color: var(--text);
  }
  .job {
    padding-block: var(--s-7) var(--s-8);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    margin-bottom: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--fs-data);
  }
  .job__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--s-5);
  }
  .rail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3) var(--s-4);
    margin: 0;
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule-ui);
    font-size: var(--fs-data);
  }
  .rail dt {
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  :global(html[lang='vi']) .rail dt {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .rail dd {
    margin: 0;
  }
  .job h1 {
    max-width: 22ch;
  }
  .apply {
    margin-top: var(--s-7);
  }
  .apply .btn {
    justify-content: center;
    width: 100%;
  }
  @media (min-width: 720px) {
    .apply .btn {
      width: auto;
    }
  }
  @media (min-width: 1080px) {
    .job__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: start;
    }
    .rail {
      grid-column: 1 / span 3;
      grid-template-columns: minmax(0, 1fr);
      position: sticky;
      top: 96px;
    }
    .job__main {
      grid-column: 4 / span 7;
    }
  }
</style>
