---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langStaticPaths } from '../../lib/paths';
import { useT, type Lang } from '../../lib/i18n';
import { ATLAS, CONTRAST_PAIRS, NEXUS, type Theme } from '../../lib/palette';
import { contrastRatio } from '../../lib/contrast';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);

// Everything below is computed at build time from palette.ts and contrast.ts.
const halves = [
  { theme: 'nexus' as Theme, title: t('tokens.nexus'), colours: NEXUS },
  { theme: 'atlas' as Theme, title: t('tokens.atlas'), colours: ATLAS },
];
const pairsOf = (theme: Theme) =>
  CONTRAST_PAIRS.filter((p) => p.theme === theme).map((p) => {
    const ratio = contrastRatio(p.fg, p.bg);
    const need = p.kind === 'text' ? 4.5 : 3;
    return { ...p, ratio, need, ok: ratio >= need };
  });
const ramp = [
  { cls: 'display-xl', name: 'display-xl · 300' },
  { cls: 'display-l', name: 'display-l · 300' },
  { cls: 'h2', name: 'h2 · 300' },
  { cls: 'h3', name: 'h3 · 600' },
  { cls: 'lead', name: 'lead · 400' },
  { cls: 'body', name: 'body · 400' },
  { cls: 'label', name: 'label · mono 500' },
  { cls: 'data', name: 'data · mono 400' },
] as const;
---

<BaseLayout lang={lang} title={t('tokens.title')} noindex nextStep={false}>
  <header class="container head">
    <p class="label">{t('tokens.eyebrow')}</p>
    <h1>{t('tokens.title')}</h1>
    <p class="lede">{t('tokens.lede')}</p>
  </header>

  <section class="container section halves" aria-labelledby="palette-h">
    <h2 id="palette-h" class="sr-only">
      {t('tokens.palette')}
    </h2>
    {halves.map((h) => (
      <div class="half" data-theme={h.theme} data-half={h.theme}>
        <h3>{h.title}</h3>
        <ul class="swatches">
          {Object.entries(h.colours).map(([name, hex]) => (
            <li>
              <span class="swatch" style={`background:${hex}`}></span>
              <span class="mono">{name}</span>
              <span class="mono dim">{hex}</span>
            </li>
          ))}
        </ul>
        <h4>{t('tokens.pairs')}</h4>
        <table class="pairs">
          <thead>
            <tr>
              <th scope="col">{t('tokens.pair')}</th>
              <th scope="col">{t('tokens.ratio')}</th>
              <th scope="col">{t('tokens.need')}</th>
            </tr>
          </thead>
          <tbody>
            {pairsOf(h.theme).map((p) => (
              <tr>
                <th scope="row">{p.label}</th>
                <td class="mono">{p.ratio.toFixed(2)}</td>
                <td class="mono">{p.need}:1</td>
              </tr>
            ))}
          </tbody>
        </table>
        <h4>{t('tokens.buttons')}</h4>
        <p class="row">
          <a class="btn btn--primary" href="#main">
            {t('tokens.primary')}
          </a>
          <a class="btn" href="#main">
            {t('tokens.secondary')}
          </a>
        </p>
        <p>
          <a href="#main">{t('tokens.link')}</a> · {t('tokens.focus')}
        </p>
      </div>
    ))}
  </section>

  <section class="container section" aria-labelledby="type-h">
    <h2 id="type-h" class="section__label">
      {t('tokens.type')}
    </h2>
    <p class="mono dim">
      {t('tokens.display')} · {t('tokens.body')} · {t('tokens.mono')}
    </p>
    <ul class="ramp">
      {ramp.map((r) => (
        <li>
          <span class="mono dim">{r.name}</span>
          <span class={`ramp__${r.cls}`}>{t('tokens.display')}</span>
        </li>
      ))}
    </ul>
    <h3>{t('tokens.diacritics')}</h3>
    <p class="display diacritics" lang="vi">
      {t('tokens.diacriticsText')}
    </p>
    <p class="diacritics" lang="vi">
      {t('tokens.diacriticsText')}
    </p>
    <p class="mono diacritics" lang="vi">
      {t('tokens.diacriticsText')}
    </p>
  </section>

  <section class="container section" aria-labelledby="grid-h">
    <h2 id="grid-h" class="section__label">
      {t('tokens.grid')}
    </h2>
    <p>{t('tokens.gridNote')}</p>
    <div class="griddemo" aria-hidden="true">
      {Array.from({ length: 12 }, (_, i) => (
        <span class="gridcol">{i + 1}</span>
      ))}
    </div>
  </section>

  <section class="container section" aria-labelledby="motion-h">
    <h2 id="motion-h" class="section__label">
      {t('tokens.motion')}
    </h2>
    <p>{t('tokens.motionNote')}</p>
    <p class="mono dim">
      --dur-fast 120ms · --dur-base 240ms · --dur-slow 600ms · --ease cubic-bezier(0.2, 0, 0, 1)
    </p>
  </section>

  <section class="container section" aria-labelledby="sig-h">
    <h2 id="sig-h" class="section__label">
      {t('tokens.signatures')}
    </h2>
    <ul class="sigs">
      <li>
        <svg viewBox="0 0 160 48" width="160" height="48" aria-hidden="true" focusable="false">
          <rect class="m m--asset" x="6" y="14" width="20" height="20" />
          <rect class="m m--sensor" x="62" y="14" width="20" height="20" />
          <rect
            class="m m--threat"
            x="118"
            y="14"
            width="20"
            height="20"
            transform="rotate(45 128 24)"
          />
        </svg>
        <span class="mono dim">{t('tokens.sig.nodes')}</span>
      </li>
      <li>
        <svg viewBox="0 0 160 48" width="160" height="48" aria-hidden="true" focusable="false">
          <polygon class="plane" points="20,34 80,14 140,34 80,44" />
        </svg>
        <span class="mono dim">{t('tokens.sig.plane')}</span>
      </li>
      <li>
        <svg viewBox="0 0 160 48" width="160" height="48" aria-hidden="true" focusable="false">
          <line class="tick-base" x1="10" y1="34" x2="150" y2="34" />
          <line class="tick" x1="80" y1="22" x2="80" y2="46" />
        </svg>
        <span class="mono dim">{t('tokens.sig.tick')}</span>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .head {
    padding-block: var(--s-8) var(--s-6);
  }
  .halves {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
  }
  .half {
    padding: var(--s-5);
    border: 1px solid var(--rule);
    background: var(--bg);
    color: var(--text);
  }
  .swatches {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-6);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: var(--s-4);
  }
  .swatches li {
    display: grid;
    gap: var(--s-1);
  }
  .swatch {
    height: 56px;
    border: 1px solid var(--rule-ui);
  }
  .dim {
    color: var(--text-dim);
    font-size: var(--fs-data);
  }
  .pairs {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--s-6);
    font-size: var(--fs-data);
  }
  .pairs th,
  .pairs td {
    padding: var(--s-1) var(--s-3) var(--s-1) 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    font-weight: 400;
  }
  .pairs thead th {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-dim);
  }
  .row {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
  }
  .ramp {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-6);
  }
  .ramp li {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule);
  }
  .ramp__display-xl {
    font: 300 var(--fs-display-xl) / 1.05 var(--font-display);
  }
  .ramp__display-l {
    font: 300 var(--fs-display-l) / 1.1 var(--font-display);
  }
  .ramp__h2 {
    font: 300 var(--fs-h2) / 1.15 var(--font-display);
  }
  .ramp__h3 {
    font: 600 var(--fs-h3) / 1.3 var(--font-strong);
  }
  .ramp__lead {
    font-size: var(--fs-lead);
  }
  .ramp__body {
    font-size: var(--fs-body);
  }
  .ramp__label {
    font: 500 var(--fs-label) var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ramp__data {
    font: 400 var(--fs-data) var(--font-mono);
  }
  .diacritics {
    max-width: none;
  }
  .griddemo {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
  }
  .gridcol {
    display: grid;
    place-items: center;
    height: 64px;
    border: 1px solid var(--accent-line);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-dim);
  }
  .gridcol:nth-child(n + 5) {
    display: none;
  }
  .sigs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
  }
  .sigs li {
    display: grid;
    gap: var(--s-2);
  }
  .m {
    stroke-width: 2;
  }
  .m--asset {
    fill: none;
    stroke: var(--text);
  }
  .m--sensor {
    fill: var(--accent);
    stroke: var(--accent);
  }
  .m--threat {
    fill: none;
    stroke: var(--threat);
  }
  .plane {
    fill: var(--surface-2);
    stroke: var(--accent-line);
    stroke-width: 1.5;
  }
  .tick-base {
    stroke: var(--rule-ui);
    stroke-width: 1.5;
  }
  .tick {
    stroke: var(--accent);
    stroke-width: 2;
  }
  @media (min-width: 720px) {
    .gridcol:nth-child(n + 5) {
      display: grid;
    }
  }
  @media (min-width: 1080px) {
    .halves {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .gridcol:nth-child(n + 9) {
      display: grid;
    }
  }
</style>
