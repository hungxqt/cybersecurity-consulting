---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import Icon from '../../components/Icon.astro';
import { formatDate } from '../../lib/content';
import { langStaticPaths } from '../../lib/paths';
import { useT, type Lang } from '../../lib/i18n';
import { SECURITY_EMAIL, SECURITY_POLICY_UPDATED } from '../../lib/site';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const host = (Astro.site ?? new URL('https://hungtran.id.vn')).host;

const outOfScope = [1, 2, 3, 4];
---

<BaseLayout lang={lang} theme="atlas" title={t('sec.title')} description={t('sec.lede')}>
  <SectionHero eyebrow={t('sec.eyebrow')} title={t('sec.title')} lede={t('sec.lede')} />

  <div class="container policy">
    <section class="section" aria-labelledby="report-h">
      <h2 id="report-h" class="label section__label">{t('sec.report.title')}</h2>
      <p>{t('sec.report.body')}</p>
      <p>
        <a class="btn btn--primary" href={`mailto:${SECURITY_EMAIL}`}>
          {t('sec.report.cta', { email: SECURITY_EMAIL })}
          <Icon name="arrow-right" />
        </a>
      </p>
    </section>

    <section class="section" aria-labelledby="include-h">
      <h2 id="include-h" class="label section__label">{t('sec.include.title')}</h2>
      <ul class="rows">
        {[1, 2, 3, 4].map((n) => <li>{t(`sec.include.${n}`)}</li>)}
      </ul>
    </section>

    <section class="section" aria-labelledby="scope-h">
      <h2 id="scope-h" class="label section__label">{t('sec.scope.title')}</h2>
      <div class="scope">
        <div>
          <h3>{t('sec.scope.in.title')}</h3>
          <ul class="rows">
            <li>{t('sec.scope.in.1', { host })}</li>
          </ul>
        </div>
        <div>
          <h3>{t('sec.scope.out.title')}</h3>
          <ul class="rows">
            {outOfScope.map((n) => <li>{t(`sec.scope.out.${n}`)}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="rules-h">
      <h2 id="rules-h" class="label section__label">{t('sec.rules.title')}</h2>
      <ul class="rows">
        {[1, 2, 3].map((n) => <li>{t(`sec.rules.${n}`)}</li>)}
      </ul>
    </section>

    <section class="section" aria-labelledby="expect-h">
      <h2 id="expect-h" class="label section__label">{t('sec.expect.title')}</h2>
      <ul class="rows">
        {[1, 2, 3, 4].map((n) => <li>{t(`sec.expect.${n}`)}</li>)}
      </ul>
    </section>

    <section class="section" aria-labelledby="faith-h">
      <h2 id="faith-h" class="label section__label">{t('sec.goodfaith.title')}</h2>
      <p>{t('sec.goodfaith.body')}</p>
    </section>

    <section class="section" aria-labelledby="txt-h">
      <h2 id="txt-h" class="label section__label">{t('sec.txt.title')}</h2>
      <p>{t('sec.txt.body')}</p>
      <p>
        <a href="/.well-known/security.txt">
          {t('sec.txt.link')} <Icon name="arrow-right" />
        </a>
      </p>
      <p class="mono updated">{t('sec.updated', { date: formatDate(SECURITY_POLICY_UPDATED, lang) })}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .policy {
    max-width: 52rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows {
    border-top: 1px solid var(--rule);
  }
  .rows li {
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }
  .scope {
    display: grid;
    gap: var(--s-6);
  }
  .scope h3 {
    margin-bottom: var(--s-3);
  }
  .updated {
    color: var(--text-dim);
    font-size: var(--fs-label);
  }
  @media (min-width: 900px) {
    .scope {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
