---
import Icon from './Icon.astro';
import { HUNT_ITEMS } from '../lib/hunt';
import { localizedPath, useT, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const strings = {
  progress: t('hunt.hud.progress', { n: '{n}' }),
  toggle: t('hunt.hud.toggle', { n: '{n}' }),
  announce: t('hunt.found.announce', { item: '{item}', n: '{n}' }),
  items: Object.fromEntries(HUNT_ITEMS.map((id) => [id, t(`hunt.item.${id}`)])),
};
---

<aside
  class="hud"
  data-theme="nexus"
  data-hud
  data-strings={JSON.stringify(strings)}
  aria-label={t('hunt.hud.label')}
>
  <button
    type="button"
    class="hud__toggle mono"
    aria-expanded="false"
    aria-controls="hud-panel"
    data-hud-toggle
  >
    <span class="hud__compact" aria-hidden="true">
      <span class="hud__crosshair"></span>
      <span data-hud-count>0/5</span>
    </span>
    <span class="hud__pips" aria-hidden="true">
      {HUNT_ITEMS.map((id) => (
        <i data-pip={id}></i>
      ))}
    </span>
    <span class="hud__label" data-hud-label>
      {t('hunt.hud.label')} 0/5
    </span>
  </button>
  <div class="hud__panel" id="hud-panel" hidden>
    <p>{t('hunt.hud.rules')}</p>
    <ul class="hud__list" data-hud-list>
      {HUNT_ITEMS.map((id) => (
        <li data-item={id}>{t(`hunt.item.${id}`)}</li>
      ))}
    </ul>
    {/*
      OWNER: commercial offer (design §10.2). hunt.complete.body promises a free 30-minute
      attack-surface walkthrough to anyone who mentions THREAT-HUNTER. Honour it, or remove the
      hunt.complete.* copy and this reward block before going live.
    */}
    <div class="hud__reward" data-hud-reward hidden>
      <strong>{t('hunt.complete.title')}</strong>
      <p>{t('hunt.complete.body')}</p>
      <a class="btn btn--primary" href={`${localizedPath(lang, '/contact/')}?hunt=THREAT-HUNTER`}>
        {t('hunt.complete.cta')}
        <Icon name="arrow-right" />
      </a>
    </div>
    <button type="button" class="hud__reset mono" data-hud-reset>
      {t('hunt.hud.reset')}
    </button>
  </div>
  <p class="sr-only" role="status" data-hud-live></p>
</aside>

<style is:global>
  /* Always Nexus (dark) because it floats over both themes (design §2.5). Square, mono, no blur. */
  .hud {
    position: fixed;
    right: var(--s-4);
    bottom: var(--s-4);
    z-index: 80;
    display: grid;
    justify-items: end;
    gap: var(--s-2);
    max-width: min(340px, calc(100vw - 2rem));
    color: var(--text);
  }
  .hud__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0;
    min-height: 44px;
    min-width: 44px;
    padding: 0 var(--s-3);
    border: 1px solid var(--rule-ui);
    border-radius: 0;
    background: var(--surface);
    color: var(--text);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease);
  }
  html[lang='vi'] .hud__toggle {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .hud__toggle:hover {
    border-color: var(--accent);
  }
  .hud__compact {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: 12px;
    letter-spacing: 0;
  }
  .hud__crosshair {
    width: 16px;
    height: 16px;
    border: 1px solid var(--accent);
    position: relative;
  }
  .hud__crosshair::before,
  .hud__crosshair::after {
    content: '';
    position: absolute;
    background: var(--accent);
  }
  .hud__crosshair::before {
    width: 6px;
    height: 2px;
    left: 4px;
    top: 6px;
  }
  .hud__crosshair::after {
    width: 2px;
    height: 6px;
    left: 6px;
    top: 4px;
  }
  .hud__label {
    display: none;
  }
  .hud__toggle:is(:hover, :focus-visible) .hud__compact {
    display: none;
  }
  .hud__toggle:is(:hover, :focus-visible) .hud__label {
    display: inline;
  }
  .hud__toggle:is(:hover, :focus-visible) {
    gap: var(--s-3);
  }
  .hud__pips {
    display: none;
    gap: 4px;
  }
  .hud__toggle:is(:hover, :focus-visible) .hud__pips {
    display: inline-flex;
  }
  .hud__pips i {
    width: 8px;
    height: 8px;
    border: 1px solid var(--rule-ui);
  }
  .hud__pips i[data-on] {
    background: var(--accent);
    border-color: var(--accent);
  }
  .hud__panel {
    width: min(340px, calc(100vw - 2rem));
    padding: var(--s-4);
    border: 1px solid var(--rule-ui);
    background: var(--surface);
    color: var(--text);
    font-size: var(--fs-small);
  }
  .hud__panel[hidden],
  .hud__reward[hidden] {
    display: none;
  }
  /* 2.4.11: while the visitor types, collapse to the 44 px toggle so fields stay visible. */
  body:has(:is(input, textarea, select):focus) .hud__panel {
    display: none;
  }
  .hud__panel p {
    margin: 0 0 var(--s-3);
    color: var(--text-dim);
  }
  .hud__list {
    list-style: none;
    margin: 0 0 var(--s-3);
    padding: 0;
    display: grid;
    gap: var(--s-1);
  }
  .hud__list li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--text-dim);
  }
  .hud__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border: 1px solid var(--rule-ui);
  }
  .hud__list li[data-found] {
    color: var(--text);
    text-decoration: line-through;
  }
  .hud__list li[data-found]::before {
    background: var(--accent);
    border-color: var(--accent);
  }
  .hud__reward {
    margin: var(--s-3) 0;
    padding: var(--s-4);
    border: 1px solid var(--rule-ui);
    background: var(--surface-2);
  }
  .hud__reward p {
    color: var(--text);
  }
  .hud__reset {
    padding: 0;
    min-height: 32px;
    border: 0;
    background: none;
    color: var(--text-dim);
    font-size: var(--fs-label);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  @media (max-width: 600px) {
    .hud {
      right: var(--s-2);
      bottom: var(--s-2);
    }
  }
</style>

<script>
  import { createHunt, isHuntItem, type Hunt } from '../lib/hunt';

  function storage(): Storage | null {
    try {
      return window.localStorage;
    } catch {
      return null;
    }
  }
  // One shared instance per page session, so in-memory fallback state survives navigations.
  const w = window as unknown as { __htHunt?: Hunt; __htHuntBound?: boolean };
  const hunt = (w.__htHunt ??= createHunt(storage()));

  function render() {
    const hud = document.querySelector<HTMLElement>('[data-hud]');
    if (!hud) return;
    const S = JSON.parse(hud.dataset.strings ?? '{}') as {
      progress: string;
      toggle: string;
      announce: string;
      items: Record<string, string>;
    };
    const found = hunt.found();
    const label = hud.querySelector<HTMLElement>('[data-hud-label]')!;
    label.textContent = `${label.textContent!.replace(/\s*\d\/5$/, '')} ${found.length}/5`;
    hud.querySelector('[data-hud-count]')!.textContent = `${found.length}/5`;
    hud
      .querySelector('[data-hud-toggle]')!
      .setAttribute('aria-label', S.toggle.replace('{n}', String(found.length)));
    hud
      .querySelectorAll<HTMLElement>('[data-pip]')
      .forEach((p) =>
        found.includes(p.dataset.pip as never)
          ? p.setAttribute('data-on', '')
          : p.removeAttribute('data-on'),
      );
    hud
      .querySelectorAll<HTMLElement>('[data-item]')
      .forEach((li) =>
        found.includes(li.dataset.item as never)
          ? li.setAttribute('data-found', '')
          : li.removeAttribute('data-found'),
      );
    hud.querySelector<HTMLElement>('[data-hud-reward]')!.hidden = !hunt.isComplete();
    document
      .querySelectorAll<HTMLElement>('[data-hunt-spot]')
      .forEach((s) =>
        found.includes(s.dataset.huntSpot as never)
          ? s.setAttribute('data-found', '')
          : s.removeAttribute('data-found'),
      );
  }

  if (!w.__htHuntBound) {
    w.__htHuntBound = true;
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const spot = target.closest<HTMLElement>('[data-hunt-spot]');
      if (spot) {
        const id = spot.dataset.huntSpot ?? '';
        if (!isHuntItem(id)) return;
        const res = hunt.find(id);
        render();
        const hud = document.querySelector<HTMLElement>('[data-hud]');
        if (res.isNew && hud) {
          const S = JSON.parse(hud.dataset.strings ?? '{}') as {
            announce: string;
            items: Record<string, string>;
          };
          hud.querySelector<HTMLElement>('[data-hud-live]')!.textContent = S.announce
            .replace('{item}', S.items[id] ?? id)
            .replace('{n}', String(res.count));
          if (res.complete) {
            const panel = hud.querySelector<HTMLElement>('#hud-panel')!;
            panel.hidden = false;
            hud.querySelector('[data-hud-toggle]')!.setAttribute('aria-expanded', 'true');
          }
        }
        return;
      }
      if (target.closest('[data-hud-toggle]')) {
        const btn = document.querySelector<HTMLElement>('[data-hud-toggle]')!;
        const panel = document.getElementById('hud-panel')!;
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        panel.hidden = open;
        return;
      }
      if (target.closest('[data-hud-reset]')) {
        hunt.reset();
        render();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const btn = document.querySelector<HTMLElement>('[data-hud-toggle]');
      const panel = document.getElementById('hud-panel');
      if (btn?.getAttribute('aria-expanded') === 'true' && panel) {
        btn.setAttribute('aria-expanded', 'false');
        panel.hidden = true;
        btn.focus();
      }
    });
  }
  document.addEventListener('astro:page-load', render);
</script>
