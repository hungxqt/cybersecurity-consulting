---
import { NODE_BY_ID } from '../lib/nexus';
import { BOARD, boardEdges, labelLines, type Journey } from '../lib/journeys';
import { useT, type Lang } from '../lib/i18n';

/**
 * The sticky situation board (design §6.3): an 8-node subset of the Nexus graph that shows where
 * the attacker is, what is compromised and what is contained at the active beat. Decorative and
 * aria-hidden: every beat names the same systems in text. Beat 1 is rendered on the server; the
 * BreachJourney script moves the token and switches rings/ticks, and sets `data-live` on the
 * journey root, which un-hides the board.
 */
interface Props {
  journey: Journey;
  lang: Lang;
}
const { journey, lang } = Astro.props;
const t = useT(lang);
const hypothetical = journey.attackerMode === 'hypothetical';
const first = journey.beats[0]!.board;
const at = (id: string) => journey.boardLayout[id]!;
const nodes = journey.boardNodes.map((id) => ({
  id,
  kind: NODE_BY_ID[id].kind,
  ...at(id),
  lines: labelLines(t(`nexus.node.${id}.short`), lang),
}));
const edges = boardEdges(journey).map((e) => ({
  id: e.id,
  kind: e.kind,
  x1: at(e.from).x,
  y1: at(e.from).y,
  x2: at(e.to).x,
  y2: at(e.to).y,
}));
const token = first.attackerAt ? at(first.attackerAt) : null;
const lineStep = BOARD.labelSize * BOARD.labelLine;
const legend = [
  { sw: 'threat', key: 'nexus.legend.threat' },
  { sw: 'asset', key: 'nexus.legend.asset' },
  { sw: 'sensor', key: 'nexus.legend.sensor' },
  { sw: 'attacker', key: 'journey.board.legend.attacker' },
  {
    sw: 'compromised',
    key: hypothetical ? 'journey.board.legend.exposed' : 'journey.board.legend.compromised',
  },
  { sw: 'contained', key: 'journey.board.legend.contained' },
];
---

<figure class="sb" data-board data-mode={journey.attackerMode} aria-hidden="true">
  <p class="label sb__label">
    {t(hypothetical ? 'journey.board.hypothetical' : 'journey.board.label')}
  </p>
  <svg
    class="sb__svg"
    viewBox={`0 0 ${BOARD.w} ${BOARD.h}`}
    focusable="false"
    data-token-dx={BOARD.token.dx}
    data-token-dy={BOARD.token.dy}
  >
    <g class="sb__dividers">
      {BOARD.dividers.map((x) => (
        <line x1={x} y1="0" x2={x} y2={BOARD.h} />
      ))}
    </g>
    <g>
      {edges.map((e) => (
        <line class="sb__edge" data-kind={e.kind} x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} />
      ))}
    </g>
    <g>
      {nodes.map((n) => (
        <g
          class="sb__node"
          data-node={n.id}
          data-kind={n.kind}
          data-x={n.x}
          data-y={n.y}
          data-compromised={first.compromised.includes(n.id as never) ? '' : undefined}
          data-contained={first.contained.includes(n.id as never) ? '' : undefined}
          transform={`translate(${n.x} ${n.y})`}
        >
          <rect
            class="sb__ring"
            x={-BOARD.ring}
            y={-BOARD.ring}
            width={BOARD.ring * 2}
            height={BOARD.ring * 2}
          />
          <rect
            class="sb__tick"
            x={BOARD.tick.dx - BOARD.tick.size / 2}
            y={BOARD.tick.dy - BOARD.tick.size / 2}
            width={BOARD.tick.size}
            height={BOARD.tick.size}
          />
          {n.kind === 'threat' ? (
            <path class="sb__mark" d="M0 -7L7 0L0 7L-7 0Z" />
          ) : (
            <rect class="sb__mark" x="-6" y="-6" width="12" height="12" />
          )}
          <text class="sb__text" text-anchor="middle" y={BOARD.labelGap + BOARD.labelSize}>
            {n.lines.map((line, i) => (
              <tspan x="0" dy={i === 0 ? 0 : lineStep}>
                {line}
              </tspan>
            ))}
          </text>
        </g>
      ))}
    </g>
    <g
      class="sb__token"
      data-token
      data-at={first.attackerAt ?? ''}
      data-off={token ? undefined : ''}
      style={
        token ? `--x:${token.x + BOARD.token.dx};--y:${token.y + BOARD.token.dy}` : '--x:0;--y:0'
      }
    >
      <path d="M0 -3.5L3.5 0L0 3.5L-3.5 0Z"></path>
    </g>
  </svg>
  <figcaption class="sb__caption">{t('journey.board.caption')}</figcaption>
  <dl class="sb__legend">
    {legend.map((l) => (
      <div>
        <dt>
          <span class={`sb-sw sb-sw--${l.sw}`}></span>
        </dt>
        <dd>{t(l.key)}</dd>
      </div>
    ))}
  </dl>
</figure>

<style>
  .sb {
    margin: 0;
  }
  .sb__label {
    margin: 0 0 var(--s-3);
  }
  /* The board stays hidden until the journey script is live, so a stuck beat-1 state never shows. */
  :global([data-journey]:not([data-live])) .sb {
    visibility: hidden;
  }
  .sb__svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 3;
    overflow: visible;
  }
  .sb__dividers line {
    stroke: var(--rule);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
  .sb__edge {
    stroke: var(--rule-ui);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
  .sb__edge[data-kind='attack'] {
    stroke: var(--threat);
    stroke-width: 1.5px;
    stroke-dasharray: 5 4;
  }
  .sb__edge[data-kind='telemetry'] {
    stroke-dasharray: 1 4;
    stroke-linecap: round;
  }

  .sb__mark {
    fill: var(--bg);
    stroke: var(--text);
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke;
  }
  .sb__node[data-kind='sensor'] .sb__mark {
    fill: var(--accent);
    stroke: var(--accent);
  }
  .sb__node[data-kind='threat'] .sb__mark {
    stroke: var(--threat);
  }
  .sb__ring {
    display: none;
    fill: none;
    stroke: var(--threat);
    stroke-width: 2px;
    vector-effect: non-scaling-stroke;
  }
  .sb__node[data-compromised] .sb__ring {
    display: inline;
  }
  [data-mode='hypothetical'] .sb__ring {
    stroke-dasharray: 4 3;
  }
  .sb__tick {
    display: none;
    fill: var(--accent);
  }
  .sb__node[data-contained] .sb__tick {
    display: inline;
  }
  .sb__text {
    fill: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 14.7px;
    letter-spacing: 0;
  }
  .sb__node[data-compromised] .sb__text {
    fill: var(--text);
  }

  .sb__token {
    transform: translate(calc(var(--x) * 1px), calc(var(--y) * 1px));
    transition: transform var(--dur-slow) var(--ease);
  }
  .sb__token path {
    fill: var(--threat);
    stroke: var(--threat);
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke;
  }
  [data-mode='hypothetical'] .sb__token path {
    fill: none;
    stroke-dasharray: 3 2;
  }
  .sb__token[data-off] {
    display: none;
  }

  .sb__caption {
    margin: var(--s-3) 0 var(--s-4);
    max-inline-size: 36ch;
    color: var(--text-dim);
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .sb__legend {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2) var(--s-4);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-data);
  }
  .sb__legend > div {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .sb__legend dt,
  .sb__legend dd {
    margin: 0;
  }
  .sb-sw {
    position: relative;
    display: inline-block;
    box-sizing: border-box;
    flex: none;
    inline-size: 12px;
    block-size: 12px;
  }
  .sb-sw::before {
    content: '';
    position: absolute;
    inset: 1px;
    box-sizing: border-box;
  }
  .sb-sw--asset::before {
    border: 1px solid var(--text);
    background: var(--bg);
  }
  .sb-sw--sensor::before {
    background: var(--accent);
  }
  .sb-sw--threat::before {
    inset: 2.5px;
    border: 1px solid var(--threat);
    rotate: 45deg;
  }
  .sb-sw--attacker::before {
    inset: 2.5px;
    background: var(--threat);
    border: 1px solid var(--threat);
    rotate: 45deg;
  }
  [data-mode='hypothetical'] .sb-sw--attacker::before {
    background: transparent;
    border-style: dashed;
  }
  .sb-sw--compromised::before {
    inset: 0;
    border: 2px solid var(--threat);
  }
  [data-mode='hypothetical'] .sb-sw--compromised::before {
    border-style: dashed;
  }
  .sb-sw--contained::before {
    inset: 3.5px;
    background: var(--accent);
  }
</style>
