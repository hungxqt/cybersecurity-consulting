---
import { createThreatStream, formatClock } from '../lib/threatSim';
import { sourceFor, socStats, stateAt } from '../lib/socDash';
import HuntSpot from './HuntSpot.astro';
import { localizedPath, useT, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

// Static first paint (also the reduced-motion view): 8 settled alerts from a fixed seed.
const stream = createThreatStream(77);
const sample = Array.from({ length: 8 }, () => stream.next());
const stats = socStats(sample);
let clock = 14 * 3600 + 2 * 60;
const rows = sample
  .map((e) => {
    clock += Math.max(1, Math.round(e.delayMs / 1000));
    return { e, time: formatClock(clock), state: stateAt(e.outcome, 10_000) };
  })
  .reverse();

const keys = [
  'soc.state.new',
  'soc.state.triaging',
  'soc.state.closed',
  'soc.state.escalated',
  'soc.sev.1',
  'soc.sev.2',
  'soc.sev.3',
  'soc.sev.4',
];
const strings = Object.fromEntries(keys.map((k) => [k, t(k)]));
const pauseStrings = JSON.stringify({ pause: t('soc.pause'), resume: t('soc.resume') });
---

<section class="section soc-wrap" aria-labelledby="soc-h">
  <div class="container">
    <div class="soc" id="soc" data-theme="nexus" data-soc>
      <h2 id="soc-h">{t('soc.tool.title')}</h2>
      <p class="lede">{t('soc.tool.lede')}</p>

      <dl class="kpis mono">
        <div>
          <dt>{t('soc.kpi.alerts')}</dt>
          <dd data-kpi="alerts">{stats.total}</dd>
        </div>
        <div>
          <dt>{t('soc.kpi.mttd')}</dt>
          <dd data-kpi="mttd">{stats.mttdMs} ms</dd>
        </div>
        <div>
          <dt>{t('soc.kpi.mttr')}</dt>
          <dd data-kpi="mttr">{stats.mttrMin} min</dd>
        </div>
        <div>
          <dt>{t('soc.kpi.escalated')}</dt>
          <dd data-kpi="escalated">{stats.escalated}</dd>
        </div>
      </dl>

      <div class="soc__scroll" role="region" tabindex="0" aria-label={t('soc.queue.caption')}>
        <table>
          <caption class="sr-only">{t('soc.queue.caption')}</caption>
          <thead>
            <tr>
              <th scope="col">{t('soc.col.time')}</th>
              <th scope="col">{t('soc.col.alert')}</th>
              <th scope="col">{t('soc.col.source')}</th>
              <th scope="col">{t('soc.col.severity')}</th>
              <th scope="col">{t('soc.col.state')}</th>
            </tr>
          </thead>
          <tbody data-queue>
            {rows.map(({ e, time, state }) => (
              <tr>
                <td class="mono">{time}</td>
                <td class="mono">{e.type}</td>
                <td>{sourceFor(e.id)}</td>
                <td>
                  <span class="sev" data-sev={e.severity}>
                    {t(`soc.sev.${e.severity}`)}
                  </span>
                </td>
                <td>
                  <span class="chip" data-state={state}>
                    {t(`soc.state.${state}`)}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="soc__note mono">
        {t('soc.note')} <HuntSpot lang={lang} id="open-port" />
      </p>
      <div class="soc__actions">
        <a class="btn btn--primary" href={localizedPath(lang, '/contact/')}>
          {t('soc.cta')}
        </a>
        <button
          type="button"
          class="btn"
          aria-pressed="false"
          data-soc-pause
          data-strings={pauseStrings}
        >
          {t('soc.pause')}
        </button>
      </div>
      <script type="application/json" id="soc-i18n" set:html={JSON.stringify(strings)} />
    </div>
  </div>
</section>

<style is:global>
  /* Dark Nexus inset on a light Atlas page. Nothing here animates or glows: the simulated
     arrivals are the only motion, severity is text plus shape, and the page's one bold element
     is the Atlas above. */
  .soc {
    padding: var(--s-5);
    background: var(--surface);
    color: var(--text);
  }
  @media (min-width: 720px) {
    .soc {
      padding: var(--s-7);
    }
  }
  .soc .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    margin: var(--s-6) 0;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .soc .kpis div {
    padding: var(--s-4) var(--s-5);
    background: var(--surface-2);
  }
  .soc .kpis dt {
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  :lang(vi) .soc .kpis dt {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .soc .kpis dd {
    margin: var(--s-1) 0 0;
    font-size: var(--fs-h3);
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .soc__scroll {
    overflow-x: auto;
    border: 1px solid var(--rule);
  }
  .soc table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
  }
  .soc th,
  .soc td {
    padding: var(--s-3) var(--s-4);
    text-align: left;
    border-bottom: 1px solid var(--rule);
    font-size: var(--fs-small);
  }
  .soc thead th {
    font: 500 var(--fs-label) var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: var(--surface-2);
  }
  :lang(vi) .soc thead th {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .soc tbody tr:last-child td {
    border-bottom: 0;
  }
  /* Severity: label text plus shape. Low Ash, Medium Cyanotype 300, High Flare outline tag,
     Critical Flare filled tag with Carbon text. */
  .soc .sev {
    display: inline-block;
    font: 500 var(--fs-data) var(--font-mono);
  }
  .soc .sev[data-sev='1'] {
    color: var(--text-dim);
  }
  .soc .sev[data-sev='2'] {
    color: var(--accent);
  }
  .soc .sev[data-sev='3'],
  .soc .sev[data-sev='4'] {
    padding: 1px 8px;
    border: 1px solid var(--threat);
    border-radius: var(--radius);
  }
  .soc .sev[data-sev='3'] {
    color: var(--threat);
  }
  .soc .sev[data-sev='4'] {
    background: var(--threat);
    color: var(--c-carbon);
    font-weight: 700;
  }
  .soc .chip {
    display: inline-block;
    padding: 2px 8px;
    border: 1px solid var(--rule-ui);
    border-radius: var(--radius);
    font: 500 var(--fs-label) var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-dim);
  }
  .soc .chip[data-state='new'] {
    border-color: var(--accent);
    color: var(--accent);
  }
  .soc .chip[data-state='triaging'] {
    color: var(--text);
  }
  .soc .chip[data-state='escalated'] {
    border-style: dashed;
    border-color: var(--threat);
    color: var(--threat);
  }
  .soc__note {
    margin: var(--s-4) 0 var(--s-5);
    font-size: var(--fs-label);
    color: var(--text-dim);
    max-width: none;
  }
  .soc__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .soc__actions .btn[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }
  /* Nothing to pause when the dashboard stays static. */
  @media (prefers-reduced-motion: reduce) {
    .soc [data-soc-pause] {
      display: none;
    }
  }
</style>

<script>
  import { createThreatStream, formatClock, type ThreatEvent } from '../lib/threatSim';
  import { socStats, sourceFor, stateAt } from '../lib/socDash';

  let stop: (() => void) | null = null;

  function boot() {
    stop?.();
    const root = document.querySelector<HTMLElement>('[data-soc]');
    if (!root) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return; // keep the static view

    const S = JSON.parse(document.getElementById('soc-i18n')!.textContent ?? '{}') as Record<
      string,
      string
    >;
    const queue = root.querySelector<HTMLElement>('[data-queue]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-soc-pause]')!;
    const labels = JSON.parse(toggle.dataset.strings ?? '{}') as { pause: string; resume: string };
    const kpi = (k: string) => root.querySelector<HTMLElement>(`[data-kpi="${k}"]`)!;
    const stream = createThreatStream(2026);
    const events: ThreatEvent[] = [];
    const live: { e: ThreatEvent; born: number; tr: HTMLTableRowElement }[] = [];
    let timer = 0;
    let visible = false;
    let paused = false;
    let started = false;
    let nextAt = 0;

    function addRow(e: ThreatEvent, now: number) {
      const d = new Date();
      const tr = document.createElement('tr');
      const cells = [
        formatClock(d.getHours() * 3600 + d.getMinutes() * 60 + d.getSeconds()),
        e.type,
        sourceFor(e.id),
      ];
      cells.forEach((text, i) => {
        const td = document.createElement('td');
        if (i < 2) td.className = 'mono';
        td.textContent = text;
        tr.append(td);
      });
      const sevTd = document.createElement('td');
      const sev = document.createElement('span');
      sev.className = 'sev';
      sev.dataset.sev = String(e.severity);
      sev.textContent = S[`soc.sev.${e.severity}`]!;
      sevTd.append(sev);
      tr.append(sevTd);
      const stateTd = document.createElement('td');
      const chip = document.createElement('span');
      chip.className = 'chip';
      stateTd.append(chip);
      tr.append(stateTd);
      queue.prepend(tr);
      while (queue.children.length > 8) queue.lastElementChild?.remove();
      live.push({ e, born: now, tr });
      events.push(e);
      if (live.length > 12) live.shift();
    }

    function paint(now: number) {
      for (const item of live) {
        const state = stateAt(item.e.outcome, now - item.born);
        const chip = item.tr.querySelector<HTMLElement>('.chip')!;
        if (chip.dataset.state !== state) {
          chip.dataset.state = state;
          chip.textContent = S[`soc.state.${state}`]!;
        }
      }
      const s = socStats(events);
      kpi('alerts').textContent = String(s.total);
      kpi('mttd').textContent = `${s.mttdMs} ms`;
      kpi('mttr').textContent = `${s.mttrMin} min`;
      kpi('escalated').textContent = String(s.escalated);
    }

    function loop() {
      if (!visible || paused || document.hidden) return;
      const now = performance.now();
      if (now >= nextAt) {
        const e = stream.next();
        addRow(e, now);
        nextAt = now + e.delayMs * 1.5;
      }
      paint(now);
    }

    function halt() {
      window.clearInterval(timer);
      timer = 0;
    }

    // The simulated arrivals run only while at least half of the panel is in view and the
    // visitor has not paused them. Until then the server-rendered 8 settled alerts stay.
    function sync() {
      if (visible && !paused) {
        if (!started) {
          started = true;
          queue.replaceChildren();
        }
        if (!timer) {
          timer = window.setInterval(loop, 250);
          loop();
        }
      } else halt();
    }

    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = paused ? labels.resume : labels.pause;
      sync();
    });

    const io = new IntersectionObserver(
      (entries) => {
        visible = entries.some((en) => en.isIntersecting);
        sync();
      },
      { threshold: 0.5 },
    );
    io.observe(root);
    stop = () => {
      io.disconnect();
      halt();
      stop = null;
    };
  }
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => stop?.());
</script>
