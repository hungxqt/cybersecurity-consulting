---
import Icon from './Icon.astro';
import { localizedHref, stripLocale, useT, type Lang } from '../lib/i18n';
import { nextSteps } from '../lib/nextStep';

interface Props {
  lang: Lang;
  /** Language-less path of the current page. */
  path?: string;
}
const { lang } = Astro.props;
const t = useT(lang);
const path = Astro.props.path ?? stripLocale(Astro.url.pathname);
const steps = nextSteps(path).map((s) => ({ ...s, href: localizedHref(lang, s.path) }));
---

<nav class="next container" aria-labelledby="next-h">
  <h2 id="next-h" class="next__h label">
    {t('next.title')}
  </h2>
  <ul>
    {steps.map((s) => (
      <li>
        <a class="next__row" href={s.href}>
          <strong class="next__title">{t(s.titleKey)}</strong>
          <span class="next__blurb">{t(s.blurbKey)}</span>
          <Icon name="arrow-right" class="next__icon" />
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .next {
    padding-block: var(--s-8) 0;
  }
  .next__h {
    margin: 0 0 var(--s-4);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
  li {
    border-top: 1px solid var(--rule);
  }
  /* One hairline row per step: title, blurb, trailing arrow. */
  .next__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--gutter);
    row-gap: var(--s-1);
    align-items: center;
    padding-block: var(--s-5);
    color: var(--text);
    text-decoration: none;
  }
  .next__title {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 300;
    line-height: 1.3;
  }
  .next__blurb {
    grid-column: 1;
    color: var(--text-dim);
  }
  .next__row :global(.next__icon) {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: 1.25rem;
    color: var(--accent);
    transition: transform var(--dur-fast) var(--ease);
  }
  .next__row:hover .next__title {
    text-decoration: underline 1px var(--accent);
    text-underline-offset: 0.2em;
  }
  .next__row:hover :global(.next__icon),
  .next__row:focus-visible :global(.next__icon) {
    transform: translateX(4px);
  }
  @media (min-width: 1080px) {
    .next__row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .next__title {
      grid-column: 1 / span 5;
    }
    .next__blurb {
      grid-column: 6 / span 6;
      grid-row: 1;
    }
    .next__row :global(.next__icon) {
      grid-column: 12;
      grid-row: 1;
      justify-self: end;
    }
  }
</style>
