---
import { useT, type Lang } from '../lib/i18n';

/**
 * Implementation process (design §7.2): numbered because the phases really are a sequence.
 * `scope` picks the phase set: the generic five on the Solutions index (laid out as columns)
 * or a solution's own phases (laid out as rows: what happens / what we need / what you receive).
 */
interface Props {
  lang: Lang;
  scope: 'index' | 'consulting' | 'audit' | 'soc';
  count?: number;
}
const { lang, scope, count = 5 } = Astro.props;
const t = useT(lang);
const phases = Array.from({ length: count }, (_, i) => i + 1);
const cols = [
  ['what', 'method.h.what'],
  ['need', 'method.h.need'],
  ['get', 'method.h.get'],
] as const;
---

<ol class:list={['method', `method--${scope === 'index' ? 'columns' : 'rows'}`]}>
  {phases.map((n) => (
    <li class="method__phase">
      <p class="method__head">
        <span class="method__num mono" aria-hidden="true">
          {n}
        </span>
        <span class="method__name">{t(`method.${scope}.p${n}.name`)}</span>
      </p>
      <dl class="method__body">
        {cols.map(([k, label]) => (
          <div>
            <dt class="label">{t(label)}</dt>
            <dd>{t(`method.${scope}.p${n}.${k}`)}</dd>
          </div>
        ))}
      </dl>
    </li>
  ))}
</ol>

<style>
  .method {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-ui);
    counter-reset: phase;
  }
  .method__phase {
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }
  .method__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin: 0;
    max-inline-size: none;
  }
  .method__num {
    flex: none;
    inline-size: 1.75rem;
    color: var(--accent);
    font-size: var(--fs-data);
    font-weight: 500;
  }
  .method__name {
    font-family: var(--font-strong);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.3;
  }
  .method__body {
    display: grid;
    gap: var(--s-3);
    margin: 0;
    padding-inline-start: calc(1.75rem + var(--s-3));
  }
  .method__body dt {
    margin: 0 0 var(--s-1);
  }
  .method__body dd {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  @media (min-width: 1080px) {
    .method--rows .method__phase {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      column-gap: var(--gutter);
      align-items: start;
    }
    .method--rows .method__body {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--gutter);
      padding-inline-start: 0;
    }
    /* The generic five phases read left to right, joined by a rule. */
    .method--columns {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: var(--gutter);
      border-bottom: 1px solid var(--rule);
    }
    .method--columns .method__phase {
      align-content: start;
      border-bottom: 0;
      padding-block: var(--s-5) var(--s-6);
    }
    .method--columns .method__body {
      padding-inline-start: 0;
    }
  }
</style>
