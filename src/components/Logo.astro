---
import { localizedPath, useT, type Lang } from '../lib/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<a class="logo" href={localizedPath(lang)} aria-label={t('a11y.logoLabel')}>
  <svg
    class="logo__mark"
    viewBox="0 0 20 20"
    width="20"
    height="20"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="0.75" y="0.75" width="18.5" height="18.5"></rect>
    <line x1="6" y1="6" x2="14" y2="10"></line>
    <line x1="14" y1="10" x2="6" y2="14"></line>
    <circle class="logo__node" cx="6" cy="6" r="2"></circle>
    <circle class="logo__node" cx="6" cy="14" r="2"></circle>
    <circle class="logo__node logo__node--accent" cx="14" cy="10" r="2.25"></circle>
  </svg>
  <span class="logo__word">{t('site.name')}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }
  .logo__mark {
    flex: none;
    width: 20px;
    height: 20px;
  }
  .logo__mark line,
  .logo__mark rect {
    stroke: currentColor;
    stroke-width: 1.5px;
    fill: none;
  }
  .logo__mark .logo__node {
    fill: currentColor;
  }
  .logo__mark .logo__node--accent {
    fill: var(--accent);
  }
  .logo__word {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  @media (max-width: 719.98px) {
    .logo__word {
      font-size: 13px;
    }
  }
</style>
