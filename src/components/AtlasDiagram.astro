---
import {
  CONTROLS,
  DEFAULT_LAYER,
  FW_KEYS,
  LAYERS,
  LENSES,
  controlsOf,
  layerKey,
  type LayerId,
  type LensId,
} from '../lib/atlas';
import { useT, type Lang } from '../lib/i18n';
import Icon from './Icon.astro';

/**
 * Security Architecture Atlas (design §6.2, §12.3): an exploded, five-layer reference
 * architecture drawn with CSS 3D planes. The planes are presentational (aria-hidden, no pointer
 * events); the un-rotated strip buttons, the panel and the table are the interface.
 */
interface Props {
  lang: Lang;
  /** Fixed lens on a solution page. When absent the lens fieldset is rendered (index). */
  lens?: LensId;
}
const { lang, lens } = Astro.props;
const t = useT(lang);

const fixed = lens !== undefined;
const activeLens: LensId = lens ?? 'consulting';
const shownLenses: readonly LensId[] = fixed ? [lens] : LENSES;
const selected: LayerId = DEFAULT_LAYER;
const selectedIndex = LAYERS.indexOf(selected);
const firstControl = controlsOf(selected)[0]!.id;
// DOM order of the strips and panels: top of the stack first (Operations to Data).
const topDown = [...LAYERS].reverse();
const showFrameworks = shownLenses.includes('audit');
---

<div class="atlas-wrap">
  {!fixed && (
    <fieldset class="atlas-lens">
      <legend class="label">{t('atlas.lens.legend')}</legend>
      {LENSES.map((l) => (
        <label class="atlas-lens__opt">
          <input type="radio" name="atlas-lens" value={l} checked={l === activeLens} />
          <span>{t(`atlas.lens.${l}`)}</span>
        </label>
      ))}
    </fieldset>
  )}

  <figure
    class="atlas"
    data-atlas
    data-lens={activeLens}
    data-fixed={fixed ? '' : undefined}
    data-sel={selected}
    aria-labelledby="atlas-cap"
  >
    <div class="atlas__stage">
      <div class="atlas__iso" aria-hidden="true">
        {LAYERS.map((l, i) => (
          <div
            class="atlas__plane"
            data-layer={l}
            style={`--z:${i}`}
            data-selected={l === selected ? '' : undefined}
            data-above={i > selectedIndex ? '' : undefined}
          >
            {controlsOf(l).map((c) => (
              <i
                class="atlas__marker"
                data-control={c.id}
                style={`--cx:${c.x}%;--cy:${c.y}%`}
                data-on={c.id === firstControl ? '' : undefined}
              />
            ))}
          </div>
        ))}
      </div>

      <div class="atlas__layers" role="group" aria-label={t('atlas.groupLabel')}>
        {topDown.map((l) => {
          const i = LAYERS.indexOf(l);
          const on = l === selected;
          return (
            <button
              type="button"
              class="atlas__strip"
              data-layer={l}
              style={`--z:${i}`}
              aria-pressed={on ? 'true' : 'false'}
              aria-controls="atlas-panel"
              tabindex={on ? 0 : -1}
              data-above={i > selectedIndex ? '' : undefined}
            >
              <span class="atlas__strip-label">{t(layerKey(l))}</span>
              <span class="sr-only">
                {' ' + t('atlas.strip.sr', { count: controlsOf(l).length })}
              </span>
            </button>
          );
        })}
      </div>

      <svg class="atlas__callouts" aria-hidden="true" focusable="false">
        <defs>
          <marker
            id="atlas-arrow"
            viewBox="0 0 8 8"
            refX="7"
            refY="4"
            markerWidth="8"
            markerHeight="8"
            orient="auto"
          >
            <path
              d="M1 0.5 L7 4 L1 7.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
            ></path>
          </marker>
        </defs>
        <line
          class="atlas__dim"
          x1="6"
          y1="30"
          x2="6"
          y2="99%"
          marker-end="url(#atlas-arrow)"
        ></line>
        <text class="atlas__dim-label" x="14" y="16">
          {t('atlas.dim')}
        </text>
      </svg>
    </div>

    <div class="atlas__panel" id="atlas-panel">
      {LAYERS.map((l) => {
        const ctls = controlsOf(l);
        const on = l === selected;
        return (
          <section class="atlas__lp" data-panel={l} data-active={on ? '' : undefined}>
            <h3>{t(layerKey(l))}</h3>
            <ul class="atlas__ctls" aria-label={t('atlas.controlsLabel')}>
              {ctls.map((c) => (
                <li>
                  <button
                    type="button"
                    class="atlas__ctl"
                    data-control={c.id}
                    aria-pressed={on && c.id === firstControl ? 'true' : 'false'}
                  >
                    {t(c.name)}
                  </button>
                </li>
              ))}
            </ul>
            <div class="atlas__details">
              {ctls.map((c) => (
                <div
                  class="atlas__detail"
                  data-detail={c.id}
                  data-active={on && c.id === firstControl ? '' : undefined}
                >
                  {shownLenses.map((L) => {
                    const key = c.lenses[L];
                    return (
                      <div class="atlas__lens-text" data-lens-text={L}>
                        {key ? (
                          <>
                            <p class="label atlas__lens-head">{t(`atlas.lensHead.${L}`)}</p>
                            <p>{t(key)}</p>
                            {L === 'audit' && c.frameworks.length > 0 && (
                              <ul
                                class="atlas__fw"
                                data-educational
                                aria-label={t('atlas.fw.label')}
                              >
                                {c.frameworks.map((f) => (
                                  <li>{t(FW_KEYS[f])}</li>
                                ))}
                              </ul>
                            )}
                          </>
                        ) : (
                          <p class="atlas__nis">{t('atlas.notInScope')}</p>
                        )}
                      </div>
                    );
                  })}
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <figcaption id="atlas-cap" class="atlas__cap">
      {t('atlas.caption')}
    </figcaption>

    <details class="atlas__table">
      <summary>
        {t('atlas.tableSummary')}
        <Icon name="caret-down" class="atlas__caret" />
      </summary>
      <div
        class="atlas__tablewrap"
        role="region"
        tabindex="0"
        aria-label={t('atlas.table.caption')}
      >
        <table>
          <caption class="sr-only">{t('atlas.table.caption')}</caption>
          <thead>
            <tr>
              <th scope="col">{t('atlas.col.layer')}</th>
              <th scope="col">{t('atlas.col.control')}</th>
              {shownLenses.map((L) => (
                <th scope="col">{t(`atlas.lensHead.${L}`)}</th>
              ))}
              {showFrameworks && <th scope="col">{t('atlas.col.frameworks')}</th>}
            </tr>
          </thead>
          <tbody>
            {CONTROLS.map((c) => (
              <tr>
                <td>{t(layerKey(c.layer))}</td>
                <th scope="row">{t(c.name)}</th>
                {shownLenses.map((L) => {
                  const key = c.lenses[L];
                  return key ? (
                    <td>{t(key)}</td>
                  ) : (
                    <td class="atlas__nis">{t('atlas.notInScope')}</td>
                  );
                })}
                {showFrameworks && (
                  <td data-educational>
                    {c.lenses.audit && c.frameworks.length > 0
                      ? c.frameworks.map((f) => t(FW_KEYS[f])).join(', ')
                      : '–'}
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </figure>
</div>

<style>
  .atlas-wrap {
    display: grid;
    gap: var(--s-4);
  }

  /* Lens radios (index only): a native fieldset, one tab stop, arrows move within. */
  .atlas-lens {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-6);
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }
  .atlas-lens legend {
    float: none;
    inline-size: 100%;
    padding: 0;
    margin-block-end: var(--s-1);
  }
  .atlas-lens__opt {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: 44px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-button);
    letter-spacing: 0.04em;
  }
  .atlas-lens__opt input {
    flex: none;
    inline-size: 18px;
    block-size: 18px;
    margin: 0;
    accent-color: var(--accent);
  }

  /* Geometry tokens per breakpoint; the same numbers live in src/lib/atlas.ts (GEOMETRY). */
  .atlas {
    --s: 200px;
    --gap: 52px;
    --explode-lift: 56px;
    --stage: 408px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--gutter);
    row-gap: var(--s-4);
    margin: 0;
  }
  @media (min-width: 720px) {
    .atlas {
      --s: 300px;
      --gap: 56px;
      --explode-lift: 96px;
      --stage: 536px;
    }
  }
  @media (min-width: 900px) {
    .atlas {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
      align-items: start;
    }
    .atlas__stage {
      grid-column: 1 / span 5;
    }
    .atlas__panel {
      grid-column: 6 / span 3;
    }
    .atlas__cap,
    .atlas__table {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1080px) {
    .atlas {
      --s: 360px;
      --stage: 576px;
    }
    .atlas__stage {
      grid-column: 1 / span 7;
    }
    .atlas__panel {
      grid-column: 8 / span 5;
    }
  }

  .atlas__stage {
    position: relative;
    block-size: var(--stage);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  /* The anchor is a zero-size box whose origin is the Data plane's front vertex. */
  .atlas__iso {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-end: calc(34px - 0.433 * var(--gap));
    inline-size: 0;
    block-size: 0;
    transform-style: preserve-3d;
    transform: rotateX(60deg) rotateZ(-45deg);
    pointer-events: none;
  }
  .atlas__plane,
  .atlas__strip {
    --lift: 0px;
  }
  .atlas__plane[data-above],
  .atlas__strip[data-above] {
    --lift: var(--explode-lift);
  }
  .atlas__plane {
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: 0;
    inline-size: var(--s);
    block-size: var(--s);
    border: 1px solid var(--accent-line);
    background-image:
      linear-gradient(to right, var(--rule) 1px, transparent 1px),
      linear-gradient(to bottom, var(--rule) 1px, transparent 1px);
    background-size: 24px 24px;
    transform: translateZ(calc(var(--z) * var(--gap) + var(--lift)));
    transition: transform var(--dur-base) var(--ease);
  }
  .atlas__plane[data-selected] {
    background-color: var(--accent-tint);
    box-shadow: inset 0 0 0 2px var(--accent);
  }
  .atlas__marker {
    position: absolute;
    inset-inline-start: var(--cx);
    inset-block-start: var(--cy);
    inline-size: 8px;
    block-size: 8px;
    margin: -4px 0 0 -4px;
    border: 1px solid var(--accent);
    background: var(--surface);
  }
  .atlas__marker[data-on] {
    background: var(--accent);
  }

  /* Un-rotated hit strips, centred on each plane's front band (design §6.2). */
  .atlas__layers {
    position: absolute;
    inset: 0;
  }
  .atlas__strip {
    position: absolute;
    inset-inline: 0;
    inset-block-end: calc(12px + var(--z) * 0.866 * var(--gap) + 0.866 * var(--lift));
    block-size: 44px;
    display: flex;
    align-items: flex-end;
    margin: 0;
    padding: 0 0 0 14px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: inset-block-end var(--dur-base) var(--ease);
  }
  .atlas__strip[data-layer='operations'] {
    inset-block-start: 0;
    block-size: auto;
  }
  /* Leader from the label to the plane's front vertex (2.25 px below the strip at gap 56). */
  .atlas__strip::after {
    content: '';
    position: absolute;
    inset-inline: 0 50%;
    inset-block-end: calc(22px - 0.433 * var(--gap));
    block-size: 1px;
    background: var(--accent-line);
    pointer-events: none;
  }
  .atlas__strip:hover {
    background: color-mix(in srgb, var(--accent-tint) 55%, transparent);
  }
  .atlas__strip:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }
  .atlas__strip-label {
    position: relative;
    display: flex;
    align-items: center;
    block-size: 44px;
    padding-inline-start: 10px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
  }
  :global(html[lang='vi']) .atlas__strip-label {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .atlas__strip[aria-pressed='true'] .atlas__strip-label {
    color: var(--accent);
    font-weight: 700;
  }
  .atlas__strip[aria-pressed='true'] .atlas__strip-label::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block: 14px;
    inline-size: 2px;
    background: var(--accent);
  }

  /* Dimension line and callout layer. */
  .atlas__callouts {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
    pointer-events: none;
    color: var(--accent-line);
  }
  .atlas__dim {
    stroke: currentColor;
    stroke-width: 1px;
  }
  .atlas__dim-label {
    fill: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  :global(html[lang='vi']) .atlas__dim-label {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .atlas__callouts :global(.atlas__leader) {
    stroke: var(--accent-line);
    stroke-width: 1px;
    fill: none;
  }
  .atlas__callouts :global(.atlas__leader-dot) {
    fill: var(--accent);
  }
  .atlas__callouts :global(.atlas__leader[data-draw]) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: atlas-draw var(--dur-base) var(--ease) forwards;
  }
  @keyframes atlas-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Panel: every layer's content shares one grid cell, so the block-size is the tallest layer
     and never changes with the selection or the lens. */
  .atlas__panel {
    display: grid;
    padding: var(--s-5);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--rule);
    min-inline-size: 0;
  }
  .atlas__lp {
    grid-area: 1 / 1;
    min-inline-size: 0;
  }
  .atlas__lp:not([data-active]),
  .atlas__detail:not([data-active]) {
    visibility: hidden;
  }
  .atlas__lp h3 {
    margin: 0 0 var(--s-3);
    font-size: var(--fs-h3);
  }
  .atlas__ctls {
    list-style: none;
    margin: 0 0 var(--s-4);
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
  .atlas__ctl {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    inline-size: 100%;
    min-block-size: 48px;
    margin: 0;
    padding: var(--s-2) var(--s-3);
    border: 0;
    border-top: 1px solid var(--rule);
    border-radius: 0;
    background: transparent;
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    line-height: 1.35;
    text-align: start;
    cursor: pointer;
  }
  .atlas__ctl::before {
    content: '';
    flex: none;
    inline-size: 8px;
    block-size: 8px;
    border: 1px solid var(--accent);
    background: var(--surface);
  }
  .atlas__ctl:hover {
    background: color-mix(in srgb, var(--accent-tint) 55%, transparent);
  }
  .atlas__ctl[aria-pressed='true'] {
    background: var(--accent-tint);
    font-weight: 600;
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .atlas__ctl[aria-pressed='true']::before {
    background: var(--accent);
  }
  .atlas__ctl:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }
  .atlas__details,
  .atlas__detail {
    display: grid;
  }
  .atlas__detail {
    grid-area: 1 / 1;
  }
  .atlas__lens-text {
    grid-area: 1 / 1;
    min-inline-size: 0;
  }
  .atlas[data-lens='consulting'] .atlas__lens-text:not([data-lens-text='consulting']),
  .atlas[data-lens='audit'] .atlas__lens-text:not([data-lens-text='audit']),
  .atlas[data-lens='soc'] .atlas__lens-text:not([data-lens-text='soc']) {
    visibility: hidden;
  }
  .atlas__lens-head {
    margin: 0 0 var(--s-1);
  }
  .atlas__lens-text p:not(.label) {
    margin: 0 0 var(--s-3);
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .atlas__nis {
    margin: 0;
    color: var(--text-dim);
    font-size: var(--fs-small);
  }
  .atlas__fw {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .atlas__fw li {
    padding: 2px var(--s-2);
    border: 1px solid var(--rule-ui);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--text-dim);
  }

  .atlas__cap {
    margin: 0;
    max-inline-size: 70ch;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: 1.5;
  }

  .atlas__table summary {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--rule-ui);
    min-block-size: 44px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-button);
    letter-spacing: 0.04em;
  }
  .atlas__table summary:hover {
    text-decoration-color: currentColor;
  }
  .atlas__table summary :global(.atlas__caret) {
    transition: transform 0.15s;
  }
  .atlas__table[open] summary :global(.atlas__caret) {
    transform: rotate(180deg);
  }
  .atlas__tablewrap {
    overflow-x: auto;
    margin-block-start: var(--s-3);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .atlas__table table {
    inline-size: 100%;
    min-inline-size: 640px;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }
  .atlas__table th,
  .atlas__table td {
    padding: var(--s-2) var(--s-3);
    text-align: start;
    vertical-align: top;
    border-top: 1px solid var(--rule);
    font-weight: 400;
  }
  .atlas__table thead th {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    border-top: 0;
  }
  :global(html[lang='vi']) .atlas__table thead th {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .atlas__table tbody th {
    font-family: var(--font-strong);
    font-weight: 600;
  }
  .atlas__table td.atlas__nis {
    color: var(--text-dim);
  }

  @media (max-width: 719.98px) {
    .atlas__panel {
      padding: var(--s-4);
    }
  }
</style>

<script>
  import {
    GEOMETRY,
    K,
    K_HALF,
    LAYERS,
    LENSES,
    type Breakpoint,
    type LayerId,
    type LensId,
  } from '../lib/atlas';

  const SVG_NS = 'http://www.w3.org/2000/svg';
  let teardown: (() => void) | null = null;

  const isLayer = (v: string | undefined): v is LayerId => LAYERS.includes(v as LayerId);
  const isLens = (v: string): v is LensId => LENSES.includes(v as LensId);

  function init(root: HTMLElement): () => void {
    const stage = root.querySelector<HTMLElement>('.atlas__stage')!;
    const panel = root.querySelector<HTMLElement>('.atlas__panel')!;
    const callouts = root.querySelector<SVGSVGElement>('.atlas__callouts')!;
    const strips = [...root.querySelectorAll<HTMLButtonElement>('.atlas__strip')];
    const planes = [...root.querySelectorAll<HTMLElement>('.atlas__plane')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const details = [...root.querySelectorAll<HTMLElement>('[data-detail]')];
    const markers = [...root.querySelectorAll<HTMLElement>('.atlas__marker')];
    const ctlButtons = [...root.querySelectorAll<HTMLButtonElement>('.atlas__ctl')];
    if (strips.length !== LAYERS.length) throw new Error('atlas strips missing');

    const wideMq = window.matchMedia('(min-width: 900px)');
    const lgMq = window.matchMedia('(min-width: 1080px)');
    const motionMq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ac = new AbortController();
    const opts = { signal: ac.signal };

    let layer: LayerId = isLayer(root.dataset.sel) ? root.dataset.sel : 'identity';
    let control = ctlButtons.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset
      .control;
    let raf = 0;

    function clearLeader() {
      callouts.querySelectorAll('[data-leader]').forEach((n) => n.remove());
    }

    /**
     * Callout leader: marker to the panel edge, only when the panel sits beside the stage.
     * The marker position is computed from the same geometry constants as the CSS (the planes
     * may still be transitioning), the control row and stage are measured once.
     */
    function drawLeader(animate: boolean) {
      clearLeader();
      if (!wideMq.matches || !control) return;
      const btn = ctlButtons.find(
        (b) =>
          b.dataset.control === control && b.closest('[data-panel]')?.hasAttribute('data-active'),
      );
      const m = markers.find((n) => n.dataset.control === control);
      if (!btn || !m) return;
      const bp: Breakpoint = lgMq.matches ? 'lg' : 'md';
      const g = GEOMETRY[bp];
      const stageRect = stage.getBoundingClientRect();
      const btnRect = btn.getBoundingClientRect();
      const panelRect = panel.getBoundingClientRect();
      const z = LAYERS.indexOf(layer);
      const zi = LAYERS.indexOf(m.closest<HTMLElement>('.atlas__plane')!.dataset.layer as LayerId);
      const lift = zi > z ? g.lift : 0;
      const cx = parseFloat(m.style.getPropertyValue('--cx')) / 100;
      const cy = parseFloat(m.style.getPropertyValue('--cy')) / 100;
      // Plane-local point relative to the front vertex (bottom-left corner of the plane).
      const lx = cx * g.s;
      const ly = (cy - 1) * g.s;
      const r = Math.SQRT1_2;
      const x1 = stageRect.width / 2 + r * (lx + ly);
      const y1 =
        stageRect.height - (34 - K_HALF * g.gap) + 0.5 * r * (-lx + ly) - K * (zi * g.gap + lift);
      const x2 = panelRect.left - stageRect.left;
      const y2 = btnRect.top + btnRect.height / 2 - stageRect.top;

      const gEl = document.createElementNS(SVG_NS, 'g');
      gEl.setAttribute('data-leader', '');
      const line = document.createElementNS(SVG_NS, 'line');
      line.setAttribute('class', 'atlas__leader');
      line.setAttribute('x1', x1.toFixed(1));
      line.setAttribute('y1', y1.toFixed(1));
      line.setAttribute('x2', x2.toFixed(1));
      line.setAttribute('y2', y2.toFixed(1));
      line.setAttribute('pathLength', '1');
      if (animate && !motionMq.matches) line.setAttribute('data-draw', '');
      const dot = document.createElementNS(SVG_NS, 'circle');
      dot.setAttribute('class', 'atlas__leader-dot');
      dot.setAttribute('cx', x1.toFixed(1));
      dot.setAttribute('cy', y1.toFixed(1));
      dot.setAttribute('r', '3');
      gEl.append(line, dot);
      callouts.append(gEl);
    }

    function apply(animateLeader: boolean) {
      const idx = LAYERS.indexOf(layer);
      root.dataset.sel = layer;
      strips.forEach((s) => {
        const i = LAYERS.indexOf(s.dataset.layer as LayerId);
        const on = i === idx;
        s.setAttribute('aria-pressed', on ? 'true' : 'false');
        s.tabIndex = on ? 0 : -1;
        s.toggleAttribute('data-above', i > idx);
      });
      planes.forEach((p) => {
        const i = LAYERS.indexOf(p.dataset.layer as LayerId);
        p.toggleAttribute('data-selected', i === idx);
        p.toggleAttribute('data-above', i > idx);
      });
      panels.forEach((p) => p.toggleAttribute('data-active', p.dataset.panel === layer));
      const inLayer = ctlButtons.filter(
        (b) => b.closest('[data-panel]')?.getAttribute('data-panel') === layer,
      );
      if (!control || !inLayer.some((b) => b.dataset.control === control)) {
        control = inLayer[0]?.dataset.control;
      }
      ctlButtons.forEach((b) =>
        b.setAttribute(
          'aria-pressed',
          b.dataset.control === control && b.closest('[data-panel]')?.hasAttribute('data-active')
            ? 'true'
            : 'false',
        ),
      );
      details.forEach((d) => d.toggleAttribute('data-active', d.dataset.detail === control));
      markers.forEach((m) => m.toggleAttribute('data-on', m.dataset.control === control));
      drawLeader(animateLeader);
    }

    function selectLayer(next: LayerId) {
      if (next === layer) return;
      layer = next;
      control = undefined;
      apply(true);
    }

    // Layer strips: roving tabindex; arrows move focus, Enter/Space (native click) select.
    strips.forEach((s) =>
      s.addEventListener('click', () => selectLayer(s.dataset.layer as LayerId), opts),
    );
    root.querySelector('.atlas__layers')!.addEventListener(
      'keydown',
      (ev) => {
        const e = ev as KeyboardEvent;
        const at = strips.indexOf(document.activeElement as HTMLButtonElement);
        if (at < 0) return;
        let to = at;
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') to = Math.max(0, at - 1);
        else if (e.key === 'ArrowDown' || e.key === 'ArrowRight')
          to = Math.min(strips.length - 1, at + 1);
        else if (e.key === 'Home') to = 0;
        else if (e.key === 'End') to = strips.length - 1;
        else return;
        e.preventDefault();
        strips.forEach((s, i) => (s.tabIndex = i === to ? 0 : -1));
        strips[to]!.focus();
      },
      opts,
    );

    // Controls in the panel.
    ctlButtons.forEach((b) =>
      b.addEventListener(
        'click',
        () => {
          control = b.dataset.control;
          apply(true);
        },
        opts,
      ),
    );

    // Lens radios (index only).
    for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="atlas-lens"]')) {
      radio.addEventListener(
        'change',
        () => {
          if (radio.checked && isLens(radio.value)) root.dataset.lens = radio.value;
        },
        opts,
      );
    }

    // Re-measure the leader when the layout changes (one read per event, not per frame).
    const redraw = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => drawLeader(false));
    };
    window.addEventListener('resize', redraw, opts);
    wideMq.addEventListener('change', redraw, opts);
    void document.fonts?.ready.then(() => {
      if (!ac.signal.aborted) drawLeader(false);
    });

    apply(false);
    root.setAttribute('data-live', '');

    return () => {
      ac.abort();
      cancelAnimationFrame(raf);
      clearLeader();
    };
  }

  function boot() {
    teardown?.();
    teardown = null;
    const root = document.querySelector<HTMLElement>('[data-atlas]');
    if (!root) return;
    try {
      teardown = init(root);
    } catch (err) {
      console.error('[atlas] init failed', err);
    }
  }

  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>
