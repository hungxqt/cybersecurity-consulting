---
import { useT, type Lang } from '../lib/i18n';

/** Technical documentation: a sample report outline and the pre-kickoff checklist. */
interface Props {
  lang: Lang;
  scope: 'consulting' | 'audit' | 'soc';
}
const { lang, scope } = Astro.props;
const t = useT(lang);
const outline = [1, 2, 3, 4, 5, 6].map((n) => t(`doc.${scope}.o${n}`));
const needs = [1, 2, 3, 4].map((n) => t(`doc.${scope}.n${n}`));
---

<div class="outline">
  <details>
    <summary>{t('doc.outline.title')}</summary>
    <ol>
      {outline.map((o) => (
        <li>{o}</li>
      ))}
    </ol>
  </details>
  <details>
    <summary>{t('doc.need.title')}</summary>
    <ul class="outline__check">
      {needs.map((n) => (
        <li>{n}</li>
      ))}
    </ul>
  </details>
</div>

<style>
  .outline {
    border-top: 1px solid var(--rule-ui);
  }
  details {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    display: flex;
    align-items: center;
    min-block-size: 56px;
    cursor: pointer;
    font-family: var(--font-strong);
    font-weight: 600;
    font-size: var(--fs-body);
  }
  ol,
  ul {
    margin: 0;
    padding: 0 0 var(--s-5);
    max-inline-size: 60ch;
  }
  ol {
    padding-inline-start: 1.75rem;
  }
  ul {
    list-style: none;
  }
  li {
    padding-block: var(--s-1);
    font-size: var(--fs-small);
  }
  ol li::marker {
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .outline__check li {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
  }
  .outline__check li::before {
    content: '';
    flex: none;
    inline-size: 10px;
    block-size: 10px;
    border: 1px solid var(--accent);
    transform: translateY(1px);
  }
</style>
