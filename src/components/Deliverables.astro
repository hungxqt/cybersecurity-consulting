---
import { useT, type Lang } from '../lib/i18n';

/** Deliverables of one solution: a table from 720 px, one stacked block per deliverable below. */
interface Props {
  lang: Lang;
  scope: 'consulting' | 'audit' | 'soc';
  count: number;
}
const { lang, scope, count } = Astro.props;
const t = useT(lang);
const rows = Array.from({ length: count }, (_, i) => {
  const k = `deliv.${scope}.d${i + 1}`;
  return { name: t(`${k}.name`), format: t(`${k}.format`), who: t(`${k}.who`) };
});
---

<table class="deliv__table">
  <caption class="sr-only">{t('deliv.title')}</caption>
  <thead>
    <tr>
      <th scope="col">{t('deliv.col.name')}</th>
      <th scope="col">{t('deliv.col.format')}</th>
      <th scope="col">{t('deliv.col.who')}</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        <th scope="row">{r.name}</th>
        <td>{r.format}</td>
        <td>{r.who}</td>
      </tr>
    ))}
  </tbody>
</table>

<ul class="deliv__blocks">
  {rows.map((r) => (
    <li>
      <h3>{r.name}</h3>
      <p class="mono">
        {r.format} · {r.who}
      </p>
    </li>
  ))}
</ul>

<style>
  .deliv__table {
    inline-size: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--rule-ui);
  }
  .deliv__table th,
  .deliv__table td {
    padding: var(--s-4) var(--s-4) var(--s-4) 0;
    text-align: start;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .deliv__table thead th {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  :global(html[lang='vi']) .deliv__table thead th {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .deliv__table tbody th {
    font-family: var(--font-strong);
    font-weight: 600;
    font-size: var(--fs-body);
  }
  .deliv__blocks {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-ui);
  }
  .deliv__blocks li {
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }
  .deliv__blocks h3 {
    margin: 0 0 var(--s-1);
    font-size: var(--fs-body);
  }
  .deliv__blocks p {
    margin: 0;
    font-size: var(--fs-data);
    color: var(--text-dim);
  }
  @media (max-width: 719.98px) {
    .deliv__table {
      display: none;
    }
    .deliv__blocks {
      display: block;
    }
  }
</style>
