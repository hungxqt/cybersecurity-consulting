---
import { getCollection } from 'astro:content';
import { publishedCredentials } from '../lib/content';
import { useT, type Lang } from '../lib/i18n';

/**
 * The only renderer of cert.* keys. Shows verified, published certifications and nothing else;
 * with none published it renders nothing at all (no heading, no empty box).
 */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const items = publishedCredentials((await getCollection('certifications')).map((c) => c.data));
---

{items.length > 0 && (
  <section class="container credentials" aria-labelledby="credentials-h">
    <h2 id="credentials-h" class="label">
      {t('credentials.title')}
    </h2>
    <ul>
      {items.map((c) => (
        <li>
          <strong>{t(c.nameKey)}</strong>
          <span class="mono">
            {c.evidenceUrl ? (
              <a href={c.evidenceUrl} rel="noopener noreferrer">
                {c.issuer}
              </a>
            ) : (
              c.issuer
            )}
          </span>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .credentials {
    padding-block: var(--s-7);
  }
  ul {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule);
  }
</style>
