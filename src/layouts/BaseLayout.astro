---
import { ClientRouter } from 'astro:transitions';
// Weight-level Fontsource files: each declares latin / latin-ext / vietnamese faces gated by
// unicode-range, so a page downloads only the subsets its text uses (design §3.1).
import '@fontsource-variable/jetbrains-mono/index.css';
import '@fontsource/be-vietnam-pro/300.css';
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/600.css';
// The LCP face (h1 = Be Vietnam Pro 300) is preloaded; Vite dedupes these with the CSS assets.
import bvp300Latin from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-300-normal.woff2?url';
import bvp300Vietnamese from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-vietnamese-300-normal.woff2?url';
import bvp300LatinExt from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-ext-300-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NextStep from '../components/NextStep.astro';
import HuntHud from '../components/HuntHud.astro';
import { LOCALES, localizedPath, stripLocale, useT, type Lang } from '../lib/i18n';
import { serializeJsonLd } from '../lib/jsonld';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path without language prefix, e.g. '/solutions/soc/'. Defaults to the current URL. */
  path?: string;
  noindex?: boolean;
  /** Show the "Where to next" cards at the end of the page. */
  nextStep?: boolean;
  /** schema.org objects to embed as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Theme scope for the page: dark Nexus (brand) or light Atlas (solutions, long-form). */
  theme?: 'nexus' | 'atlas';
}

const {
  lang,
  title,
  description,
  noindex = false,
  nextStep = true,
  jsonLd,
  theme = 'nexus',
} = Astro.props;
const themeColor = theme === 'atlas' ? '#F2F4F5' : '#0D0F11';
const fontPreloads = lang === 'vi' ? [bvp300Latin, bvp300Vietnamese, bvp300LatinExt] : [bvp300Latin];
const t = useT(lang);
const path = Astro.props.path ?? stripLocale(Astro.url.pathname);
const site = Astro.site ?? new URL('https://hungtran.id.vn');
const canonical = new URL(localizedPath(lang, path), site).href;
const metaDescription = description ?? t('site.description');
const fullTitle = title === t('site.name') ? title : `${title} · ${t('site.name')}`;
const ogLocale = lang === 'vi' ? 'vi_VN' : 'en_US';
const ogImage = new URL(`/og/${lang}.png`, site).href;
---

<!doctype html>
<html lang={lang} dir="ltr" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    {fontPreloads.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localizedPath(l, path), site).href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizedPath('en', path), site).href}
    />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.tagline')} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('a11y.skip')}
    </a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
      {nextStep && <NextStep lang={lang} path={path} />}
    </main>
    <Footer lang={lang} />
    <HuntHud lang={lang} />
    <script>
      import '../scripts/prefetch';
    </script>
  </body>
</html>
