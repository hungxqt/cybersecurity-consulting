{
  "name": "hungtran-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/vi-placeholders.mjs --strict && astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "og": "node scripts/og.mjs",
    "vi:sync": "node scripts/sync-vi.mjs",
    "vi:content": "node scripts/sync-vi-content.mjs",
    "vi:report": "node scripts/vi-placeholders.mjs",
    "lhci": "lhci autorun",
    "lhci:desktop": "lhci autorun --config=lighthouserc.desktop.json"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "astro": "7.3.7",
    "gsap": "3.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
