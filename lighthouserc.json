{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4321/en/",
        "http://localhost:4321/vi/",
        "http://localhost:4321/en/solutions/soc/",
        "http://localhost:4321/en/experience/journeys/vendor-account/",
        "http://localhost:4321/en/blog/alert-queue-is-lying/",
        "http://localhost:4321/en/contact/"
      ],
      "numberOfRuns": 1,
      "startServerCommand": "npm run preview",
      "startServerReadyPattern": "localhost:4321",
      "settings": { "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/en/.*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "total-byte-weight": ["warn", { "maxNumericValue": 1500000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "render-blocking-resources": ["warn", { "maxLength": 1 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 112640 }]
          }
        },
        {
          "matchingUrlPattern": ".*/vi/.*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "total-byte-weight": ["warn", { "maxNumericValue": 1500000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "render-blocking-resources": ["warn", { "maxLength": 1 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 215040 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
